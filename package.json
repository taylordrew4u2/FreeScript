{
  "name": "freescript",
  "version": "1.0.0",
  "description": "Free, offline screenwriting for Mac.",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --universal",
    "test:desktop": "npm run build && node tests/desktop.e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taylordrew4u2/FreeScript.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/taylordrew4u2/FreeScript/issues"
  },
  "homepage": "https://github.com/taylordrew4u2/FreeScript#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  }
}
